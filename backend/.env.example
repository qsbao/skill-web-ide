# ── Prompt Lab LLM Configuration ──
# OpenAI-compatible API endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# Examples:
# Anthropic via LiteLLM:  LLM_BASE_URL=http://localhost:4000/v1
# Ollama (local):         LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3
